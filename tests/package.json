{
  "name": "huisu-zhilian-tests",
  "version": "1.0.0",
  "description": "慧宿智联智能酒店系统测试套件",
  "scripts": {
    "test:api": "node api/newman_runner.js",
    "test:perf:load": "k6 run performance/k6_load_test.js",
    "test:perf:stress": "k6 run performance/k6_stress_test.js",
    "test:perf:spike": "k6 run performance/k6_spike_test.js",
    "test:e2e": "cd e2e && npx playwright test",
    "test:e2e:ui": "cd e2e && npx playwright test --ui",
    "test:e2e:report": "cd e2e && npx playwright show-report",
    "test:backend": "cd ../backend/iot-hotel-backend && npm test",
    "test:backend:coverage": "cd ../backend/iot-hotel-backend && npm run test:coverage",
    "test:frontend": "cd ../frontend/iot-hotel-web && npx vitest run",
    "test:frontend:coverage": "cd ../frontend/iot-hotel-web && npx vitest run --coverage",
    "report:generate": "node scripts/generate_test_report.js",
    "report:merge": "node scripts/merge_reports.js",
    "ci:test": "npm run test:backend && npm run test:frontend && npm run test:api"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "newman": "^6.0.0",
    "newman-reporter-htmlextra": "^1.23.0",
    "vitest": "^1.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^23.0.0"
  },
  "keywords": [
    "testing",
    "api-testing",
    "e2e-testing",
    "performance-testing",
    "smart-hotel"
  ]
}
