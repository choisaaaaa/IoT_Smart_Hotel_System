{
  "info": {
    "_postman_id": "iot-device-api-collection",
    "name": "IoT设备控制API测试集合",
    "description": "慧宿智联智能酒店系统 - IoT设备控制API测试\n对应配图：8.2 设备控制API测试报告\n\n测试范围：\n1. 设备指令下发 API\n2. 设备状态查询 API\n3. 环境数据获取 API\n4. 批量设备控制 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01-认证登录",
      "item": [
        {
          "name": "管理员登录获取Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('登录成功', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(200);",
                  "    pm.expect(jsonData.data.token).to.exist;",
                  "    pm.environment.set('adminToken', jsonData.data.token);",
                  "});",
                  "",
                  "pm.test('响应时间小于 200ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02-设备指令下发API",
      "item": [
        {
          "name": "发送开灯指令",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"device_id\": \"room_101_light\",\n    \"command\": \"turn_on\",\n    \"params\": {}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/room_101_light/command",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices", "room_101_light", "command"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('指令下发成功', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(200);",
                  "    pm.expect(jsonData.message).to.contain('成功');",
                  "});",
                  "",
                  "pm.test('响应时间小于 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "发送关灯指令",
          "request": {
