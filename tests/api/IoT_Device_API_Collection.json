            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"device_id\": \"room_101_light\",\n    \"command\": \"turn_off\",\n    \"params\": {}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/room_101_light/command",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices", "room_101_light", "command"]
