            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"device_id\": \"room_101_light\",\n    \"command\": \"invalid_command\",\n    \"params\": {}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/room_101_light/command",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices", "room_101_light", "command"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('无效指令返回错误', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.be.oneOf([400, 422]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03-设备状态查询API",
      "item": [
        {
          "name": "查询单个设备状态",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/room_101_light/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices", "room_101_light", "status"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('设备状态查询成功', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(200);",
                  "    pm.expect(jsonData.data).to.have.property('online');",
                  "    pm.expect(jsonData.data).to.have.property('state');",
                  "});",
                  "",
                  "pm.test('响应时间小于 200ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
