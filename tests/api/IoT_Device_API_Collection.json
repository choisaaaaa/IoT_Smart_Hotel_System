    },
    {
      "name": "05-批量设备控制API",
      "item": [
        {
          "name": "批量控制房间所有设备",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"room_id\": 101,\n    \"commands\": [\n        {\n            \"device_id\": \"room_101_light\",\n            \"command\": \"turn_on\"\n        },\n        {\n            \"device_id\": \"room_101_ac\",\n            \"command\": \"turn_on\"\n        },\n        {\n            \"device_id\": \"room_101_curtain\",\n            \"command\": \"open\"\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/batch-control",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices", "batch-control"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('批量控制成功', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(200);",
                  "    pm.expect(jsonData.data).to.have.property('success_count');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
