# 统一硬件基线参数（当前工程目标为 ESP32-S3，勿使用已废弃的 CONFIG_ESP32_DEFAULT_CPU_*，否则会报 unknown kconfig symbol）
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_HZ=1000

# 优化 FreeRTOS 任务调度与看门狗
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# 优化编译输出体积
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# 真实 WiFi；SoftAP 配网默认 Security 0（App 里关掉「Encrypted Communication」即可）
CONFIG_SERVICE_NETWORK_USE_MOCK=n
CONFIG_SERVICE_NETWORK_SOFTAP_PROVISIONING=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0=y
CONFIG_FRONT_DESK_NET_TEST_MODE=n

# 演示：房卡只读 UID、不写扇区（展会/答辩）；生产环境改 n 并 fullclean 重编
CONFIG_FRONT_DESK_DEMO_CARD_UID_ONLY=y

# ---------- 客房主控（本仓库默认刷成客房端）----------
# MQTT: hotel/device/command/room/room_<房号>；注册 device_type=room；NVS 键 Room_ID（默认房号见 main.c）
# 改回前台机：CONFIG_TERMINAL_ROLE_FRONT_DESK=y 且 # CONFIG_TERMINAL_ROLE_ROOM is not set，并关闭下面 RC522
# CONFIG_TERMINAL_ROLE_FRONT_DESK is not set
CONFIG_TERMINAL_ROLE_ROOM=y
CONFIG_TERMINAL_ROOM_ENABLE_RC522=y

# 默认 single app 仅 1MB，固件增长后 app_check_size 会失败；改用 large（factory≈1500K，4MB Flash 可接受）
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y