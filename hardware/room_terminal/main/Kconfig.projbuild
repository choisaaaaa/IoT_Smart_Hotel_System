menu "Room terminal (main)"

    config ROOM_TERMINAL_NET_TEST_MODE
        bool "仅配网 + MQTT 联调（跳过全部外设初始化）"
        default n
        help
            启用后 app_main 只执行：NVS、WiFi 配网、MQTT 连接，
            并在 hotel/net_test/broadcast 上订阅/心跳，便于多块板互通验证。
            关闭后恢复完整客房终端业务（OLED/RC522/HAL 等）。

endmenu
