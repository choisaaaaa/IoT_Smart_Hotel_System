# =============================================================================
# 智慧酒店物联网控制系统 - 后端环境变量配置模版
# 复制此文件并重命名为 .env，然后根据实际部署环境修改以下配置
# =============================================================================

# -----------------------------------------------------------------------------
# 基础服务配置 (Server Settings)
# -----------------------------------------------------------------------------
# 服务监听端口
PORT=3000
# 运行环境: development (开发) / production (生产)
NODE_ENV=development
# 后端服务主机地址 (默认为 127.0.0.1)
APP_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# 数据库配置 (MySQL Settings)
# -----------------------------------------------------------------------------
# 数据库主机
DB_HOST=localhost
# 数据库端口
DB_PORT=3306
# 数据库登录用户名
DB_USER=root
# 数据库登录密码
DB_PASSWORD=your_password_here
# 数据库名称
DB_NAME=iot_hotel_system

# -----------------------------------------------------------------------------
# 安全与认证 (Security Settings)
# -----------------------------------------------------------------------------
# JWT 签名密钥: 请务必在生产环境中使用长且随机的字符串
# 生成建议: 可以使用 openssl rand -base64 32 生成
JWT_SECRET=your_super_secret_key_change_me
# Token 过期时间 (例如: 24h, 7d)
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------
# 物联网通信 (MQTT Settings)
# -----------------------------------------------------------------------------
# MQTT 代理服务器地址 (例如: mqtt://localhost)
MQTT_HOST=mqtt://localhost
# MQTT 端口 (默认 1883)
MQTT_PORT=1883
# MQTT 认证用户名 (如果 Mosquitto 开启了认证)
MQTT_USERNAME=
# MQTT 认证密码
MQTT_PASSWORD=
# 系统在 MQTT 中使用的唯一客户端 ID 前缀
MQTT_CLIENT_ID=hotel_backend_service

# -----------------------------------------------------------------------------
# 人工智能引擎 (AI Butler - 智谱 AI)
# -----------------------------------------------------------------------------
# 智谱 AI API Key (从智谱开放平台获取)
ZHIPU_AI_API_KEY=your_zhipu_ai_api_key_here

# -----------------------------------------------------------------------------
# 静态资源与文件上传 (Upload Settings)
# -----------------------------------------------------------------------------
# 文件上传保存路径 (绝对路径或相对于项目根目录的路径)
UPLOAD_PATH=uploads
# 访问静态资源的公网前缀 (例如: http://your-domain.com/uploads)
# 开发环境通常为 http://localhost:3000/uploads
UPLOAD_PUBLIC_URL=http://localhost:3000/uploads
