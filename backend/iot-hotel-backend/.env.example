# =============================================================================
# 智慧酒店物联网控制系统 - 后端环境变量配置模版
# 适用于无域名的示例系统/开发环境
# =============================================================================

# -----------------------------------------------------------------------------
# 基础服务配置 (Server Settings)
# -----------------------------------------------------------------------------
# 服务监听地址 (0.0.0.0 允许所有IP访问，127.0.0.1 仅本地访问)
APP_HOST=127.0.0.1
# 服务监听端口
APP_PORT=3000
# 运行环境: development (开发) / production (生产)
NODE_ENV=development
# API前缀
API_PREFIX=/api/v1
# 公网访问地址 (示例系统可留空或使用IP)
APP_PUBLIC_URL=

# -----------------------------------------------------------------------------
# 数据库配置 (MySQL Settings)
# -----------------------------------------------------------------------------
# 数据库主机 (示例系统通常使用localhost或IP地址)
DB_HOST=localhost
# 数据库端口
DB_PORT=3306
# 数据库登录用户名
DB_USER=root
# 数据库登录密码 (请修改为强密码)
DB_PASSWORD=your_db_password
# 数据库名称
DB_NAME=iot_hotel_system

# -----------------------------------------------------------------------------
# 安全与认证 (Security Settings) - 重要！
# -----------------------------------------------------------------------------
# JWT 签名密钥: 必须设置，至少32位随机字符串
# 生成命令: openssl rand -hex 32
# ⚠️ 警告: 以下只是示例，生产环境请重新生成！
JWT_SECRET=4f7b2c9a1d8e5f3c0b6a2d9e8f7c1b5a3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a
# Token 过期时间 (例如: 24h, 7d)
JWT_EXPIRES_IN=24h

# 允许的前端域名 (无域名示例系统使用IP和localhost)
# 格式: 协议://IP:端口，多个用逗号分隔
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# 物联网通信 (MQTT Settings)
# -----------------------------------------------------------------------------
# MQTT 代理服务器地址 (示例系统使用localhost或IP)
MQTT_HOST=localhost
# MQTT 端口 (默认 1883, TLS使用8883)
MQTT_PORT=1883
# MQTT 认证用户名 (如果开启了认证)
MQTT_USERNAME=
# MQTT 认证密码
MQTT_PASSWORD=
# 系统在 MQTT 中使用的唯一客户端 ID 前缀
MQTT_CLIENT_ID=hotel_backend_service

# 语音 Agent（MQTT 上行桥接）：未在 devices 表审核通过时的兜底 device_id，逗号分隔。
# 旧仿真器/演示常用 front_desk_01、front_desk_02。生产环境请留空并在后台审核设备。
# VOICE_AGENT_EXTRA_APPROVED_DEVICE_IDS=front_desk_02,front_desk_01
# 是否启用TLS (示例系统建议false，生产环境建议true)
MQTT_USE_TLS=false
# TLS CA证书路径 (示例系统可留空)
MQTT_CA_CERT_PATH=
# TLS客户端证书路径 (双向认证时使用，示例系统可留空)
MQTT_CLIENT_CERT_PATH=
# TLS客户端密钥路径 (双向认证时使用，示例系统可留空)
MQTT_CLIENT_KEY_PATH=

# -----------------------------------------------------------------------------
# 人工智能引擎 (AI Butler - 智谱 AI)
# 如需使用AI功能，请配置以下密钥
# -----------------------------------------------------------------------------
# 智谱 AI API Key (从智谱开放平台 https://open.bigmodel.cn 获取)
ZHIPU_AI_API_KEY=your_zhipu_ai_api_key_here

# -----------------------------------------------------------------------------
# 讯飞语音服务 (可选)
# 如需使用讯飞语音识别，请配置以下密钥
# -----------------------------------------------------------------------------
XFYUN_APP_ID=your_xfyun_app_id
XFYUN_API_KEY=your_xfyun_api_key
XFYUN_API_SECRET=your_xfyun_api_secret

# -----------------------------------------------------------------------------
# 阿里云百炼ASR (可选)
# 如需使用阿里云语音识别，请配置以下密钥
# 获取方式：登录阿里云百炼控制台 https://bailian.console.aliyun.com/
# 进入"密钥管理"创建API Key
# -----------------------------------------------------------------------------
# 百炼API Key (用于实时语音识别WebSocket连接)
ALIYUN_ACCESS_KEY=your_aliyun_access_key
# 可选：百炼APP KEY (如需要)
ALIYUN_APP_KEY=your_aliyun_app_key

# -----------------------------------------------------------------------------
# Redis 缓存配置 (Redis Settings)
# 示例系统可以不安装Redis，系统会降级使用内存缓存
# -----------------------------------------------------------------------------
# Redis 服务器地址
REDIS_HOST=127.0.0.1
# Redis 端口 (默认 6379)
REDIS_PORT=6379
# Redis 密码 (如果没有设置密码，留空)
REDIS_PASSWORD=
# Redis 数据库编号 (0-15)
REDIS_DB=0
# Redis 键前缀 (用于区分不同应用的缓存)
REDIS_KEY_PREFIX=iot_hotel:
# 是否启用缓存
CACHE_ENABLED=true
# 默认缓存过期时间 (秒)
CACHE_DEFAULT_TTL=300

# -----------------------------------------------------------------------------
# 静态资源与文件上传 (Upload Settings)
# -----------------------------------------------------------------------------
# 文件上传保存路径 (相对于项目根目录)
UPLOAD_PATH=public/uploads
# 访问静态资源的URL前缀 (示例系统使用相对路径)
UPLOAD_PUBLIC_URL=/uploads

# -----------------------------------------------------------------------------
# 日志配置 (Logging Settings)
# -----------------------------------------------------------------------------
# 日志级别: error, warn, info, debug
LOG_LEVEL=info
# 日志目录
LOG_DIR=./logs

# -----------------------------------------------------------------------------
# WebRTC 配置 (语音通话功能 - 可选)
# 如需使用语音通话，请配置TURN服务器
# -----------------------------------------------------------------------------
# TURN服务器地址 (示例系统可留空)
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_PASSWORD=

# =============================================================================
# 示例系统快速启动配置 (复制以下内容到 .env 即可运行)
# =============================================================================
# APP_HOST=127.0.0.1
# APP_PORT=3000
# NODE_ENV=development
# API_PREFIX=/api/v1
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=iot_hotel_system
# JWT_SECRET=4f7b2c9a1d8e5f3c0b6a2d9e8f7c1b5a3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a
# JWT_EXPIRES_IN=24h
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MQTT_HOST=localhost
# MQTT_PORT=1883
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# CACHE_ENABLED=false
# LOG_LEVEL=info
